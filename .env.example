# PostgreSQL connection string (e.g. Neon, Supabase, Vercel Postgres)
# Required for Prisma at build time (prisma db push) and runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Super admin credentials — NEVER hardcode these in source code.
# Set strong, unique values in your production environment.
SUPER_ADMIN_EMAIL="your-admin-email@example.com"
SUPER_ADMIN_PASSWORD="your-very-strong-admin-password"
